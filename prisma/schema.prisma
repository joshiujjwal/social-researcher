// Prisma Schema — SocialResearcher
// Run: npx prisma migrate dev --name <description>
// Run: npx prisma generate  (after any schema change)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum SourceType {
  reddit
  hackernews
  twitter
  linkedin
}

enum JobStatus {
  pending
  running
  complete
  failed
}

enum SentimentLabel {
  positive
  neutral
  negative
}

// ── Models ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quota tracking
  jobsToday     Int      @default(0)
  quotaResetAt  DateTime @default(now())
  isPaidTier    Boolean  @default(false)

  jobs ResearchJob[]

  @@index([clerkId])
}

model ResearchJob {
  id          String      @id @default(uuid())
  userId      String
  topic       String
  sources     SourceType[]
  status      JobStatus   @default(pending)
  error       String?
  tokenUsage  Int?
  deletedAt   DateTime?   // soft delete

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User          @relation(fields: [userId], references: [id])
  results     SourceResult[]
  report      SynthesisReport?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model SourceResult {
  id          String     @id @default(uuid())
  jobId       String
  source      SourceType
  url         String
  title       String
  content     String     @db.Text
  score       Int        @default(0)
  author      String?
  publishedAt DateTime?
  fetchedAt   DateTime   @default(now())

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, url])  // dedup by URL within a job
  @@index([jobId])
  @@index([source])
}

model SynthesisReport {
  id           String         @id @default(uuid())
  jobId        String         @unique
  consensus    String         @db.Text
  dissent      String         @db.Text
  sentiment    Json           // { score: number, label: SentimentLabel, breakdown: {...} }
  keyPeople    Json           // Array<{ name, handle?, platform, reason }>
  trendingThreads Json        // Array<{ title, url, platform, engagement }>
  sourceBreakdown Json        // Record<SourceType, { count, avgScore }>
  rawJson      String         @db.Text  // full GPT-4o response for debugging
  generatedAt  DateTime       @default(now())

  job ResearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
