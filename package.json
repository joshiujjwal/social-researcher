{
  "name": "social-researcher",
  "version": "0.1.0",
  "description": "Aggregate and synthesize social media discussions on any topic with GPT-4o",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "tsc --project tsconfig.build.json",
    "build:client": "npm --prefix client run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:api": "vitest run tests/unit tests/integration",
    "test:client": "npm --prefix client test",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/express": "^1.0.0",
    "@prisma/client": "^5.0.0",
    "bullmq": "^5.0.0",
    "express": "^5.0.0",
    "ioredis": "^5.0.0",
    "openai": "^4.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.0.0",
    "supertest": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
