# Required — copy this file to .env and fill in values
# Never commit .env — it is gitignored

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_researcher_dev"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/social_researcher_test"

# ── Redis / BullMQ ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ── Reddit API ─────────────────────────────────────────────────────────────────
# Create app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID="your_reddit_client_id"
REDDIT_CLIENT_SECRET="your_reddit_client_secret"
REDDIT_USER_AGENT="SocialResearcher/1.0 by /u/your_username"

# ── Twitter / X API v2 ─────────────────────────────────────────────────────────
# Get from https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN="your_twitter_bearer_token"

# ── SerpAPI (LinkedIn + fallback) ──────────────────────────────────────────────
# Get from https://serpapi.com
SERPAPI_KEY="your_serpapi_key"

# ── Clerk (Auth) ───────────────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# ── App Config ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
CLIENT_URL="http://localhost:5173"

# ── Rate Limits ────────────────────────────────────────────────────────────────
MAX_JOBS_PER_HOUR=10
MAX_JOBS_PER_DAY_FREE=5
MAX_JOBS_PER_DAY_PAID=100
